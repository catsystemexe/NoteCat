# Sdílený tajný token – stejná hodnota se vyplní v aplikaci (Nastavení → Přístupový token).
# Vygeneruj např.: openssl rand -hex 24
NOTECAT_TOKEN=

# Přepis řeči (OpenAI Whisper)
OPENAI_API_KEY=

# AI úprava textu (Claude). Nepovinné, pokud jsi přihlášen přes `ant auth login`.
ANTHROPIC_API_KEY=

# Volitelné:
# POLISH_MODEL=claude-opus-4-8   # levnější varianta: claude-haiku-4-5
# WHISPER_MODEL=whisper-1
# PORT=8787
# DATA_DIR=./data
